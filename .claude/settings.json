{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(**/.dev.vars)",
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.production)",
			"Read(**/.env.*.local)",
			"Read(**/*.env)",
			"Read(**/.envrc)",
			"Bash(*--no-verify*)",
			"Bash(git push --force*)",
			"Bash(git push -f*)"
		]
	},
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Skill|Read",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.ts\""
					}
				]
			}
		]
	}
}
